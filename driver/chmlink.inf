[Version]
Signature = "$WINDOWS NT$"
Class = Net
ClassGuid = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider = %Provider%
DriverVer = 10/30/2026,0.3.0.0
CatalogFile = chmlink.cat
PnpLockdown = 1

[Manufacturer]
%Provider% = Models,NTamd64.10.0...14393,NTamd64.10.0...25319

[Models.NTamd64.10.0...14393]
%DeviceDescription% = InstallLegacy, Root\ChmLink
%IpDeviceDescription% = InstallIpLegacy, Root\ChmLinkIP

[Models.NTamd64.10.0...25319]
%DeviceDescription% = InstallStore, Root\ChmLink
%IpDeviceDescription% = InstallIpStore, Root\ChmLinkIP

[InstallLegacy.NT]
Characteristics = 0x81
BusType = 15
CopyFiles = DriverCopy
AddReg = NetworkSettings

[InstallStore.NT]
Characteristics = 0x81
BusType = 15
CopyFiles = DriverCopyStore
AddReg = NetworkSettings

[InstallIpLegacy.NT]
Characteristics = 0x81
BusType = 15
CopyFiles = DriverCopy
AddReg = IpNetworkSettings

[InstallIpStore.NT]
Characteristics = 0x81
BusType = 15
CopyFiles = DriverCopyStore
AddReg = IpNetworkSettings

[DriverCopy]
chmlink.sys,,,2

[DriverCopyStore]
chmlink.sys

[DestinationDirs]
DriverCopy = 12
DriverCopyStore = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
chmlink.sys = 1

[NetworkSettings]
HKR, Ndi, Service, 0, "chmlink"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "nolower"
HKR,, *IfType, 0x00010001, 6
HKR,, *MediaType, 0x00010001, 0
HKR,, *PhysicalMediaType, 0x00010001, 0
HKR,, *IfConnectorPresent, 0x00010001, 0
HKR,, *PriorityVLANTag, 0x00010001, 0

[IpNetworkSettings]
HKR, Ndi, Service, 0, "chmlink"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "nolower"
HKR,, *IfType, 0x00010001, 53
HKR,, *MediaType, 0x00010001, 19
HKR,, *PhysicalMediaType, 0x00010001, 0
HKR,, *IfConnectorPresent, 0x00010001, 0

[InstallLegacy.NT.Services]
AddService = chmlink, 2, Service

[InstallStore.NT.Services]
AddService = chmlink, 2, ServiceStore

[InstallIpLegacy.NT.Services]
AddService = chmlink, 2, Service

[InstallIpStore.NT.Services]
AddService = chmlink, 2, ServiceStore

[Service]
DisplayName = %ServiceDescription%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\chmlink.sys
LoadOrderGroup = NDIS

[ServiceStore]
DisplayName = %ServiceDescription%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\chmlink.sys
LoadOrderGroup = NDIS

[Strings]
Provider = "QZhua Team"
DeviceDescription = "ChmLAN Link"
IpDeviceDescription = "ChmLAN Link IP"
ServiceDescription = "ChmLink Virtual Ethernet Adapter"
DiskName = "ChmLink Driver Package"
