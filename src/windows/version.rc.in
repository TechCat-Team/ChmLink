// Version information of chmlink.dll, from include/chmlink/version.h.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @CHMLINK_VERSION_COMMAS@
PRODUCTVERSION @CHMLINK_VERSION_COMMAS@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ChmLink"
            VALUE "FileDescription", "ChmLink virtual network adapter library"
            VALUE "FileVersion", "@CHMLINK_VERSION@"
            VALUE "InternalName", "chmlink"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "chmlink.dll"
            VALUE "ProductName", "ChmLink"
            VALUE "ProductVersion", "@CHMLINK_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
